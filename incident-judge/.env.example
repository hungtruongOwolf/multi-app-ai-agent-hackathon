# ---- mode ---------------------------------------------------------------
# sandbox = everything local (emulated Sentry/Linear/Instatus/Slack on :8900; PagerDuty and GitHub off)
# real    = the SaaS APIs, plus PagerDuty and GitHub when their credentials are set
IJ_BACKEND=sandbox
TIME_SCALE=1.0
# IJ_TRIAL_ID=            # set by eval runner
# IJ_BASELINE=            # B0 no-policy | B1 no-memory | B2 no-verify | B3 no-match-conditions
# IJ_TOOL_FAULTS=         # path to tool fault plan JSON (eval)

# ---- LLM ----------------------------------------------------------------
ANTHROPIC_API_KEY=
IJ_JUDGE_IMPL=            # claude | heuristic (default: claude if key present)
IJ_JUDGE_MODEL=claude-sonnet-5
IJ_MEMORY_MODEL=claude-opus-5

# ---- ShopLab -------------------------------------------------------------
SHOPLAB_SUPERVISOR_URL=http://127.0.0.1:8800
SHOPLAB_CONTROL_TOKEN=dev-control-token

# ---- real mode only (see docs/SETUP.md; `judge bootstrap` fills the ids) ---------
# Sentry: errors from ShopLab, read by the agent
SENTRY_ORG=
SENTRY_TOKEN=
SENTRY_DSN_PROD=
SENTRY_DSN_STAGING=
# Linear: one ticket per incident
LINEAR_API_KEY=
LINEAR_TEAM_ID=
LINEAR_EVAL_LABEL_ID=
LINEAR_ASSIGNEE_ID=
# Instatus: public status page
INSTATUS_API_KEY=
INSTATUS_PAGE_ID=
INSTATUS_PAGE_URL=
INSTATUS_COMPONENTS=
INSTATUS_SHOULD_PUBLISH=false
# Slack: incident thread + approval buttons (app token = Socket Mode)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_ONCALL_CHANNEL=
ONCALL_SLACK_USER_IDS=
# PagerDuty (optional): Events API v2 integration key
PAGERDUTY_ROUTING_KEY=
# GitHub (optional): runbook updates as pull requests against knowledge/ in this repo
GITHUB_TOKEN=
GITHUB_REPO=
